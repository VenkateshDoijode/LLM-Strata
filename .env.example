# ================================================================================
# .env.example — Environment variables for LLM Strata
# Copy this to .env and fill in the values for your active provider.
# You only need the keys for the provider set in profiles.yaml.
# ================================================================================

# — OpenAI (provider: openai) ─────────
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1

# — Azure OpenAI (provider: azure) ─────────────────────
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# — Google Gemini (provider: gemini) ─────────────────────────────
# GEMINI_API_KEY=AIza...                           # free at aistudio.google.com
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/

# — Anthropic (provider: anthropic) — also requires: pip install litellm ──────
# ANTHROPIC_API_KEY=sk-ant-...

# — AWS Bedrock (provider: bedrock) — also requires: pip install litellm boto3
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# — Hugging Face (provider: huggingface) ─────────────────────
# HF_TOKEN=hf_...                                  # huggingface.co/settings/tokens
# HF_ENDPOINT=https://api-inference.huggingface.co/v1/

# — Ollama (provider: ollama) — no key needed, local only ─────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1

# — Private/on-prem OpenAI-compatible server ─────────────────
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=local-key              # only when api_key_required: true

# — LangFuse (all providers — for production monitoring) ─────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com